{
  "info": {
    "_postman_id": "a7f3c8d2-4b11-4f9e-9c21-8f2a1d9e0001",
    "name": "JSONPlaceholder REST API \u2014 QA Portfolio (Anton Zverkov)",
    "description": "Manual & automated REST API test collection covering GET, POST, PUT, PATCH, DELETE, query filtering, and negative 404 scenarios against https://jsonplaceholder.typicode.com/",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://jsonplaceholder.typicode.com",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. GET All Posts (200 OK & Array Check)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response is a non-empty array of 100 posts', function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data).to.be.an('array');",
              "    pm.expect(data.length).to.eql(100);",
              "});",
              "pm.test('Response time is under 1500ms', function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(1500);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ]
        }
      }
    },
    {
      "name": "2. GET Single Post by ID (200 OK & Schema Check)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Post object contains required fields', function () {",
              "    const post = pm.response.json();",
              "    pm.expect(post).to.have.all.keys('userId', 'id', 'title', 'body');",
              "    pm.expect(post.id).to.eql(1);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "1"
          ]
        }
      }
    },
    {
      "name": "3. GET Posts Filtered by userId Query Param",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('All returned posts belong to userId = 1', function () {",
              "    const posts = pm.response.json();",
              "    pm.expect(posts.length).to.be.above(0);",
              "    posts.forEach(p => pm.expect(p.userId).to.eql(1));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts?userId=1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ],
          "query": [
            {
              "key": "userId",
              "value": "1"
            }
          ]
        }
      }
    },
    {
      "name": "4. GET Nested Resource \u2014 Comments for Post 1",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Comments belong to postId = 1 and have valid email format', function () {",
              "    const comments = pm.response.json();",
              "    pm.expect(comments).to.be.an('array').that.is.not.empty;",
              "    comments.forEach(c => {",
              "        pm.expect(c.postId).to.eql(1);",
              "        pm.expect(c.email).to.include('@');",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/1/comments",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "1",
            "comments"
          ]
        }
      }
    },
    {
      "name": "5. POST Create New Post (201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Response echoes submitted payload and assigns new ID', function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res.title).to.eql('QA API Test Post');",
              "    pm.expect(res.userId).to.eql(1);",
              "    pm.expect(res.id).to.be.a('number');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"QA API Test Post\",\n  \"body\": \"Verifying POST creation payload and 201 response\",\n  \"userId\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/posts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts"
          ]
        }
      }
    },
    {
      "name": "6. PUT Full Update Post 1 (200 OK)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Updated title and body returned correctly', function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res.id).to.eql(1);",
              "    pm.expect(res.title).to.eql('Updated QA Post Title');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 1,\n  \"title\": \"Updated QA Post Title\",\n  \"body\": \"Full replacement body via PUT\",\n  \"userId\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/posts/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "1"
          ]
        }
      }
    },
    {
      "name": "7. DELETE Post 1 (200 OK)",
      "event": [
